{
  "opencollection": "1.0.0",
  "info": {
    "name": "SavvyCal Meetings Current User API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Current User",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get current user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.savvycal.com/v1/me"
          },
          "docs": "Get the currently authenticated user's profile information."
        }
      ]
    }
  ],
  "bundled": true
}